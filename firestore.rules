rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Resumes collection
    match /resumes/{resumeId} {
      allow read, write: if request.auth != null && 
        ((resource == null && request.resource.data.userId == request.auth.uid) || 
         (resource != null && resource.data.userId == request.auth.uid && (request.resource == null || request.resource.data.userId == request.auth.uid)));
    }

    // Assessments collection
    match /assessments/{assessmentId} {
      allow read, write: if request.auth != null && 
        ((resource == null && request.resource.data.userId == request.auth.uid) || 
         (resource != null && resource.data.userId == request.auth.uid && (request.resource == null || request.resource.data.userId == request.auth.uid)));
    }

    // Positions collection - public read, write allowed for seeding
    match /positions/{positionId} {
      allow read, write: if true;
    }

    // Favorites collection
    match /favorites/{favoriteId} {
      allow read, write: if request.auth != null && 
        ((resource == null && request.resource.data.userId == request.auth.uid) || 
         (resource != null && resource.data.userId == request.auth.uid && (request.resource == null || request.resource.data.userId == request.auth.uid)));
    }
  }
}
